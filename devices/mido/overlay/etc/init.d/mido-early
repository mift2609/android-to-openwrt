#!/bin/sh /etc/rc.common
# mido early debug: nyalakan IP statis + tinynet (http 8080 / shell 23) SEBELUM layanan lain,
# lalu tulis dmesg/logread berkala ke /tmp/boot.log supaya macet boot bisa didiagnosis.
START=16

start() {
	# tunggu interface gadget
	i=0
	while [ $i -lt 60 ]; do
		[ -e /sys/class/net/usb0 ] && break
		i=$((i+1)); sleep 0.25
	done
	IFC=usb0
	[ -e /sys/class/net/br-hotspot ] && IFC=br-hotspot
	ip link set usb0 up 2>/dev/null
	ip addr add 192.168.42.1/24 dev usb0 2>/dev/null

	# kanal debug
	[ -x /bin/tinynet ] && {
		/bin/tinynet http >/tmp/http.err 2>&1 &
		/bin/tinynet >/tmp/shell.err 2>&1 &
	}

	# log berkala (5 menit) supaya keadaan macet bisa dibaca
	(
		i=0
		while [ $i -lt 100 ]; do
			{
				echo "=== t=$((i*3))s ==="
				date
				echo "--- uptime ---"; uptime
				echo "--- ip ---"; ip -4 addr 2>&1 | grep -E "inet|^[0-9]"
				echo "--- ps ---"; ps w 2>&1 | tail -20
				echo "--- dmesg tail ---"; dmesg 2>&1 | tail -25
				echo "--- logread tail ---"; logread 2>&1 | tail -25
			} > /tmp/boot.log 2>&1
			i=$((i+1)); sleep 3
		done
	) &
}
