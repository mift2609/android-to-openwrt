#!/bin/sh /etc/rc.common
# ModemManager Alpine (/opt/mm). polkitd diaktifkan otomatis oleh dbus.
# Butuh: dbus (S60), udev-alpine (S61, isi DB /run/udev/data), modem sudah up.
START=91

PROG=/opt/mm/usr/sbin/ModemManager
LIBD=/opt/mm/usr/lib

start() {
	killall ModemManager 2>/dev/null
	sleep 1
	mkdir -p /var/run/modemmanager /var/lib/ModemManager
	env LD_LIBRARY_PATH="$LIBD" setsid "$PROG" --debug >/tmp/mmf.log 2>&1 < /dev/null &
	logger -t mm "start MM alpine (lib=$LIBD prog=$PROG)"
	echo "start $(date): prog=$PROG lib=$LIBD" >>/tmp/mmf.log
}

stop() {
	killall ModemManager 2>/dev/null
}

restart() {
	stop
	sleep 2
	start
}