# Tambahan opsi khusus tag kernel v7.1.3-r1 — simpan TERPISAH dari fragment utama.
#
# Alasan: simbol di bawah baru ada di kernel yang lebih baru dari 6.13; kalau ia ditulis di
# fragment utama, tag 6.13.6-r0 gagal validasi (sudah kejadian, run 43584436697). CI menerapkan
# berkas ini HANYA kalau namanya cocok dengan tag yang sedang dibangun.
CONFIG_NETFILTER_XTABLES_LEGACY=y
# SoC ARM64 yang muncul setelah 6.13 — pastikan mati di kernel yang punya simbolnya.
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
