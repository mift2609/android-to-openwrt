# Fragment config kernel untuk Xiaomi Redmi 4A (rolex, MSM8917).
# Target: msm89x7-mainline/linux tag v7.1.3-r1.
#
# Diverifikasi dengan: scripts/build/apply-config-fragment.sh --tree <kernel> --fragment <file ini>
# (skrip itu memvalidasi tiap simbol ke Kconfig dan membuktikan hasilnya di .config)
#
# STATUS: simbol clock/interconnect di bawah sudah dicocokkan dengan Kconfig repo msm89x7
# (MSM_GCC_8917 ada di drivers/clk/qcom/Kconfig, interconnect lewat msm8916). Tetap jalankan
# skrip penerap untuk membuktikannya di tag yang kamu pakai — nama simbol bisa berubah.

# --- VA 48-bit eksplisit (PITFALL) -------------------------------------------
# Choice "Virtual address space size" default-nya 52-bit; Cortex-A53 (ARMv8.0) tidak
# mendukung 52-bit VA -> MMU fault saat init, reboot tanpa log. Paksa 48-bit.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set

# --- clock + interconnect (wajib =y: tanpa ini clock peripheral tak bisa di-toggle) ---
CONFIG_MSM_GCC_8917=y
CONFIG_INTERCONNECT_QCOM_MSM8916=y

# --- USB gadget (RNDIS/ECM) --------------------------------------------------
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# --- netfilter/nftables + routing -------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_NAT=y
# NF_NAT_MASQUERADE itu simbol tersembunyi: ia TIDAK punya prompt dan hanya ikut menyala kalau
# target masquerade-nya diaktifkan. Di kernel 6.19 itu berarti NETFILTER_XT_TARGET_MASQUERADE
# (iptables legacy) dan/atau NFT_MASQ (nftables). Menulis CONFIG_NF_NAT_MASQUERADE=y saja
# tidak mendarat — persis yang dilaporkan apply-config-fragment.sh di CI.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NFT_MASQ=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y

# --- filesystem rootfs -------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- console layar (bring-up tanpa serial) ----------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y

# --- remoteproc/WCNSS/modem: =m, dimuat dari rootfs oleh init script ---------
CONFIG_QCOM_SMD_RPM=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QRTR=y
CONFIG_QCOM_SMEM=y

# --- SLIM (permintaan user 13 Nov 2026): bangun HANYA yang dibutuhkan OpenWrt ---
# hotspot portable + layar console untuk cek log. Di luar itu (kamera, speaker/
# audio, bluetooth, GPU DRM penuh, driver vendor lain) bikin build lama dan
# kernel gemuk (defconfig arm64: 3384 =y + 1404 =m, Image 54,6 MB) — matikan.
# DEBUG_INFO di kernel ini simbol turunan dari choice: mematikannya harus
# memilih CONFIG_DEBUG_INFO_NONE=y, men-disable DEBUG_INFO langsung dibatalkan olddefconfig
CONFIG_DEBUG_INFO_NONE=y
# Anggota choice lama dari defconfig WAJIB dimatikan juga: dua anggota choice =y
# bersamaan membuat olddefconfig mempertahankan pilihan lama (DWARF_TOOLCHAIN_DEFAULT).
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_SLIMBUS is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_IIO is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_DRM_MSM is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_PCI is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_ATH10K_PCI is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH12K is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MICROSEMI is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# jalur hotspot WAJIB tetap hidup (modul, dimuat dari rootfs): WiFi WCNSS rolex
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m

