#!/bin/busybox sh
# rolex /init — initramfs tahap awal (jalur B).
#
# DISALIN DARI POLA mido (Redmi Note 4X) yang TERBUKTI boot sampai OpenWrt/LuCI jalan di
# perangkat nyata. Pelajaran yang membuat versi sebelumnya gagal:
#   * JANGAN `mount --move /dev /proc /sys` manual lalu `switch_root`. Busybox switch_root
#     memindahkan ketiganya SENDIRI. Kalau dipindah dua kali, initramfs kehilangan /dev/null
#     dan procd menerima /dev yang salah -> menggantung di "procd: - ubus -".
#   * JANGAN menempel tmpfs di /tmp milik rootfs baru dari initramfs.
#   * Cukup: siapkan /tmp dan /run di initramfs, mount rootfs rw, lalu exec switch_root.
#
# Tambahan khusus rolex: USB gadget (RNDIS+ECM) dinyalakan lebih dulu supaya perangkat bisa
# diakses dari laptop walau layar/panel belum benar.

/bin/busybox --install -s /bin 2>/dev/null
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc     proc  /proc 2>/dev/null
mount -t sysfs    sysfs /sys  2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /tmp /run /newroot 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /tmp 2>/dev/null
mount -t tmpfs  tmpfs  /run 2>/dev/null
export INITRAMFS=1

# console: opsional, jangan sampai kegagalannya membunuh init
if [ -e /dev/tty0 ]; then
  exec >/dev/tty0 2>&1
elif [ -e /dev/console ]; then
  exec >/dev/console 2>&1
fi

echo
echo "=== android-to-openwrt initramfs (pola mido) ==="
echo "kernel: $(uname -r)"

GADGET_IP="${GADGET_IP:-192.168.42.1}"
DEVICE_MAC="${DEVICE_MAC:-02:1a:11:00:42:02}"
HOST_MAC="${HOST_MAC:-02:1a:11:00:42:01}"

# --- USB gadget (RNDIS + ECM) ------------------------------------------------
# configfs WAJIB di-mount; tanpa itu `mkdir /sys/kernel/config/usb_gadget/g1` gagal dan
# tidak ada jaringan USB sama sekali (terbukti di layar pada percobaan sebelumnya).
mkdir -p /sys/kernel/config
mount -t configfs none /sys/kernel/config 2>/dev/null

setup_gadget() {
  G=/sys/kernel/config/usb_gadget/g1
  [ -d "$G" ] && return 0
  mkdir -p "$G" || return 1
  echo 0x1d6b > "$G/idVendor"
  echo 0x0104 > "$G/idProduct"
  mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
  echo "android-openwrt" > "$G/strings/0x409/product"
  echo "android-to-openwrt" > "$G/strings/0x409/manufacturer"
  echo "$DEVICE_MAC" > "$G/strings/0x409/serialnumber"
  echo 250 > "$G/configs/c.1/MaxPower"
  mkdir -p "$G/functions/rndis.usb0" "$G/functions/ecm.usb0"
  echo "$DEVICE_MAC" > "$G/functions/rndis.usb0/dev_addr"
  echo "$HOST_MAC"   > "$G/functions/rndis.usb0/host_addr"
  echo "$DEVICE_MAC" > "$G/functions/ecm.usb0/dev_addr"
  echo "$HOST_MAC"   > "$G/functions/ecm.usb0/host_addr"
  ln -sf "$G/functions/rndis.usb0" "$G/configs/c.1/"
  ln -sf "$G/functions/ecm.usb0"   "$G/configs/c.1/" 2>/dev/null || true
  i=0
  while [ $i -lt 30 ]; do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] && break
    sleep 0.5; i=$((i+1))
  done
  [ -n "${UDC:-}" ] || { echo "[!] tidak ada /sys/class/udc — PHY/dwc3 gagal probe?"; return 1; }
  echo "$UDC" > "$G/UDC" 2>/dev/null || { echo "[!] gagal bind UDC $UDC"; return 1; }
  echo "[ok] gadget bind ke $UDC"
}

if setup_gadget; then
  i=0
  while [ $i -lt 20 ]; do
    NETDEV=$(ls /sys/class/net 2>/dev/null | grep -E '^(usb|rndis|eth)' | head -1)
    [ -n "$NETDEV" ] && break
    sleep 0.5; i=$((i+1))
  done
  if [ -n "${NETDEV:-}" ]; then
    ip link set "$NETDEV" up
    ip addr add "$GADGET_IP/24" dev "$NETDEV" 2>/dev/null
    echo "[ok] $NETDEV = $GADGET_IP/24 (host: 192.168.42.2/24)"
  else
    echo "[!] netdev gadget tidak muncul"
  fi
else
  echo "[!] gadget gagal — perangkat tetap boot, tapi tidak ada jaringan USB"
fi

# --- cari rootfs -------------------------------------------------------------
# Nomor device tidak stabil (eMMC bisa mmcblk0 atau mmcblk1, bertukar dengan slot SD), jadi
# pakai blkid lalu jatuh ke pemindaian semua partisi. Rootfs = ext4 berisi /sbin/init.
i=0
while [ $i -lt 60 ]; do
  for d in /dev/mmcblk*p*; do [ -b "$d" ] && break 2; done
  sleep 0.5; i=$((i+1))
done

find_rootfs() {
  CAND="${ROOTFS_CANDIDATES:-}"
  [ -n "$CAND" ] || CAND=$(blkid 2>/dev/null | grep -i 'TYPE="ext4"' | cut -d: -f1 | tr '\n' ' ')
  [ -n "$CAND" ] || CAND=$(ls -1 /dev/mmcblk*p* 2>/dev/null | tr '\n' ' ')
  for p in $CAND; do
    [ -b "$p" ] || continue
    mkdir -p /newroot 2>/dev/null
    # rw, seperti mido: OpenWrt langsung mengelola /overlay tanpa remount tambahan
    if mount -t ext4 -o rw,noatime "$p" /newroot 2>/dev/null; then
      if [ -x /newroot/sbin/init ] && [ -d /newroot/etc/config ]; then
        echo "$p"; return 0
      fi
      echo "    $p: ext4 sah, bukan rootfs"
      umount /newroot 2>/dev/null
    fi
  done
  return 1
}

ROOTDEV=$(find_rootfs)
if [ -n "$ROOTDEV" ]; then
  echo "[ok] rootfs -> $ROOTDEV — switch_root (switch_root memindahkan /dev,/proc,/sys sendiri)"
  # INITRAMFS=1 dipakai fase awal saja: procd membaca env ini (getenv) dan kalau terbawa
  # sistem dilaporkan sebagai "initramfs" -> LuCI menampilkan peringatan recovery mode
  # walau rootfs sudah ext4 rw (perubahan sebenarnya persist).
  unset INITRAMFS
  exec switch_root /newroot /sbin/init
fi

echo "[!] rootfs tidak ditemukan — shell darurat; coba lagi tiap 10 s"
while true; do
  sleep 10
  ROOTDEV=$(find_rootfs)
  if [ -n "$ROOTDEV" ]; then
    echo "[ok] rootfs -> $ROOTDEV — switch_root"
    unset INITRAMFS
    exec switch_root /newroot /sbin/init
  fi
done