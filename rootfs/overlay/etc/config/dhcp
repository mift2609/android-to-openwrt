
config dnsmasq
	option domainneeded '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option localservice '1'
	option ednspacket_max '1232'
	option localuse '1'
	# Klien menanyakan dnsmasq di :53 (jalur ini yang terbukti jalan). dnsmasq
	# meneruskan semuanya ke AdGuard Home di 127.0.0.1:5353 untuk penyaringan iklan;
	# AGH lalu meneruskan ke DNS publik (8.8.8.8/1.1.1.1).
	# CATATAN PENTING: jangan menaruh AdGuard langsung di :53 untuk klien — pernah
	# dicoba dan membuat klien WiFi "tersambung tapi tanpa internet" (iPhone iOS).
	option noresolv '1'
	option port '53'
	list server '127.0.0.1#5353'

# PENTING: nama interface HARUS 'usb' dan 'wifi' (lihat /etc/config/network).
# Sebelumnya seksi DHCP menunjuk interface 'lan' yang TIDAK ADA -> dnsmasq tak
# menghasilkan dhcp-range sama sekali (tidak dengar UDP/67) -> klien WiFi/LAN
# tak pernah mendapat IP, walau asosiasi WiFi & sinyal bagus.
config dhcp 'usb'
	option interface 'usb'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option force '1'

config dhcp 'wifi'
	option interface 'wifi'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option force '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
