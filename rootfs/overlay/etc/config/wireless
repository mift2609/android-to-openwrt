config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/a204000.remoteproc/remoteproc/remoteproc2/remoteproc2:smd-edge/remoteproc2:smd-edge.WCNSS_CTRL.-1.-1/a204000.remoteproc:smd-edge:wcnss:wifi'
	option band '2g'
	option channel '11'
	option htmode 'HT40'
	option cell_density '0'
	option country 'ID'
	option ieee80211d '1'
	option txpower '20'
	# 802.11b rate dibuang: tiap klien lambat (1/2/5.5/11 Mbit) memakan airtime
	# seluruh sel. Tanpa rate legacy, klien tetap bisa 802.11g/n.
	option legacy_rates '0'
	option disabled '0'

config wifi-iface 'wifinet0'
	option device 'radio0'
	option mode 'ap'
	option network 'wifi'
	option ssid 'rolex-hotspot'
	option encryption 'psk2'
	# PMF opsional, bukan wajib: HP lama tetap bisa masuk
	option ieee80211w '0'
	# jangan tendang klien sinyal lemah
	option disassoc_low_ack '0'
	# klien menganggur jangan diputus (bawaan 300 s -> HP sering ke-drop)
	option max_inactivity '86400'
	option key 'rolex12345'
	option macaddr '12:00:00:00:00:0a'
