# AP rolex dikelola netifd/wpad (radio0 -> vif phy0-ap0, hostapd global). Skrip
# /etc/init.d/rolex-wifi (hostapd manual) DIMATIKAN.
#
# Kenapa butuh patokan khusus di image ini (bukan sekadar config standar):
#   * wcn36xx TIDAK bisa dibuatkan vif oleh hostapd ("hostapd.add_iface ...
#     No such device"), jadi lib/netifd/wireless/mac80211.sh di-overlay:
#     wdev membuat vif AP dulu, baru hostapd menyentuhnya.
#   * hostapd di image ini jalan tanpa capability efektif (CapEff=0) sehingga
#     "set interface flags: Operation not permitted"; /etc/init.d/wpad di-overlay
#     menjalankannya sebagai root bila penanda /etc/rolex-wpad-root ada.
#   * `qos_map_set` dan `vlan_naming/vlan_file` ditolak driver/hostapd ini;
#     lib/netifd/hostapd.sh di-overlay melewatkannya bila /etc/rolex-hostapd-no-vlan ada.
# `option ifname` sengaja TIDAK di-set supaya netifd memakai nama bawaan phy0-ap0.
# Setelan di bawah dipakai penuh oleh netifd, jadi mengubahnya lewat LuCI ikut terpakai.
package wireless

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/a204000.remoteproc/remoteproc/remoteproc2/remoteproc2:smd-edge/remoteproc2:smd-edge.WCNSS_CTRL.-1.-1/a204000.remoteproc:smd-edge:wcnss:wifi'
	option band '2g'
	option channel '11'
	option htmode 'HT40'
	option cell_density '0'
	option country 'ID'
	option txpower '20'
	option legacy_rates '1'

config wifi-iface 'wifinet0'
	option device 'radio0'
	option mode 'ap'
	option network 'wifi'
	option ssid 'rolex-hotspot'
	option encryption 'psk2'
	option key 'rolex12345'
	option macaddr '12:00:00:00:00:0a'
