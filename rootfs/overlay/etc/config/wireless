# AP rolex dijalankan /etc/init.d/rolex-wifi (hostapd manual).
# Layanan `wpad` DIMATIKAN dan `wifi-scripts` tetap terpasang: tanpa hostapd global milik netifd,
# netifd tidak bisa memegang driver mode wlan0 maupun menghapus vif kita (resep paritas mido).
# Karena itu radio0 TIDAK perlu ditandai `disabled`.
# Setelan di bawah dipakai skrip (SSID/sandi/channel/htmode dibaca dari sini dan diselaraskan
# tiap menit oleh rolex-watchdog), jadi mengubahnya lewat LuCI atau `uci set` ikut terpakai.
package wireless

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/a204000.remoteproc/remoteproc/remoteproc2/remoteproc2:smd-edge/remoteproc2:smd-edge.WCNSS_CTRL.-1.-1/a204000.remoteproc:smd-edge:wcnss:wifi'
	option band '2g'
	option channel '11'
	option htmode 'HT40'
	option cell_density '0'
	option country 'ID'
	option txpower '20'
	option legacy_rates '1'

config wifi-iface 'wifinet0'
	option device 'radio0'
	option mode 'ap'
	option network 'wifi'
	option ssid 'rolex-hotspot'
	option encryption 'psk2'
	option key 'rolex12345'
	option ifname 'wlan0'
	option macaddr '12:00:00:00:00:0a'
