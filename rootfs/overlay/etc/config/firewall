config defaults
	option syn_flood '1'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config zone
	option name 'hotspot'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option masq '1'
	option mtu_fix '1'
	list network 'usb'
	list network 'wifi'

# WAN = wwan0 (LTE). input DROP: tidak ada layanan di perangkat ini yang perlu
# dijangkau dari internet (LuCI, ttyd, bandix, AGH cukup dari LAN). Carrier memang
# memberi IP privat, tapi jangan bergantung pada itu.
config zone
	option name 'wan'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option masq '1'
	option mtu_fix '1'
	list device 'wwan0'

config forwarding
	option src 'hotspot'
	option dest 'wan'