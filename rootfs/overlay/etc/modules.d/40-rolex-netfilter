# Modul netfilter + tty modem yang harus ada sebelum fw4/firewall4 jalan.
#
# Dibaca oleh /etc/init.d/rolex-nft-modules (bukan kmodloader: di image ini kmodloader
# mencetak "loading kernel modules from ...40-rolex-netfilter*" tapi tidak memasukkan
# satu pun modul — lihat komentar di init script itu).
#
# URUTAN PENTING: dependensi lebih dulu.
#
# --- fondasi reject/log (dependency untuk nft_reject_inet) ---
nf_reject_ipv4
nf_reject_ipv6
nf_log_syslog
nf_log_ipv4
nf_log_arp
# --- rantai NAT + conntrack (yang bikin fw4 gagal sebelumnya) ---
nft_chain_nat
nft_nat
nft_masq
nft_redir
nft_ct
nft_reject
nft_reject_inet
# --- ekspresi lain yang dipakai fw4/aturan tambahan ---
nft_log
nft_limit
nft_quota
nft_connlimit
nft_numgen
nft_hash
nft_osf
nft_synproxy
nft_tunnel
nft_fib_ipv4
nft_fib_ipv6
nft_dup_ipv4
nft_dup_ipv6
nft_dup_netdev
nft_fwd_netdev
# --- proxy transparan (Nikki/OpenClash) ---
nft_tproxy
nft_socket
nft_compat
nf_flow_table
# --- xtables legacy (iptables; NAT rolex + proxy) ---
xt_TPROXY
xt_REDIRECT
xt_socket
xt_state
xt_limit
xt_quota
xt_mark
xt_comment
xt_multiport
xt_mac
xt_iprange
xt_string
