#!/bin/sh /etc/rc.common
# Panel OpenWrt untuk rolex (biner: /usr/bin/panel, sumber: tools/webpanel).
# Berjalan di port sendiri, LuCI (uhttpd :80) tidak diubah.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/panel

start_service() {
	[ -x "$PROG" ] || { logger -t panel "biner $PROG tidak ada"; return 1; }
	# sandi dari /etc/config/panel, kalau kosong pakai bawaan
	[ -n "$(uci -q get panel.main.password)" ] || uci -q set panel.main.password='rolex'
	[ -n "$(uci -q get panel.main.port)" ] || uci -q set panel.main.port='8081'
	uci -q commit panel

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		PANEL_PORT="$(uci -q get panel.main.port)" \
		PANEL_PASSWORD="$(uci -q get panel.main.password)"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t panel "berhenti"
}
