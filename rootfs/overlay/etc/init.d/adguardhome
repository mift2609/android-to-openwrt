#!/bin/sh /etc/rc.common
# AdGuard Home — DNS penyaring iklan/malware untuk rolex.
# Dipasang manual (bukan dari feed) karena tak ada di image/feed 24.10.
# Letak: /opt/AdGuardHome/AdGuardHome, konfigurasi /opt/AdGuardHome/AdGuardHome.yaml

START=94
STOP=10
USE_PROCD=1

NAME=AdGuardHome
PROG=/opt/AdGuardHome/AdGuardHome
WORKDIR=/opt/AdGuardHome
CONF=$WORKDIR/AdGuardHome.yaml

start_service() {
	[ -x "$PROG" ] || { logger -t adguardhome "binary tak ada: $PROG"; return 1; }
	procd_open_instance
	procd_set_param command "$PROG" --no-check-update --config "$CONF" --work-dir "$WORKDIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_close_instance
}

reload_service() {
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "adguardhome"
}
