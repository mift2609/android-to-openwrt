#!/bin/sh /etc/rc.common
# Adaptor BFR WEBUI untuk OpenWrt: menyajikan frontend BFR apa adanya (dist ter-embed)
# dan menerjemahkan API-nya ke data OpenWrt. Port sendiri (8082); LuCI (:80) tidak diubah.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/bin/bfr-adapter

start_service() {
	[ -x "$PROG" ] || { logger -t bfr-adapter "biner $PROG tidak ada"; return 1; }
	[ -n "$(uci -q get panel.main.password)" ] || uci -q set panel.main.password='rolex'
	[ -n "$(uci -q get panel.main.bfr_port)" ] || uci -q set panel.main.bfr_port='8082'
	uci -q commit panel

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		BFR_PORT="$(uci -q get panel.main.bfr_port)" \
		BFR_PASSWORD="$(uci -q get panel.main.password)"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}