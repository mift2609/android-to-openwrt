#!/bin/sh /etc/rc.common
# rolex-nat — penghitung trafik wwan0 (chain ROLXSTAT) untuk halaman Modem LTE.
#
# Dulu skrip ini juga memasang MASQUERADE lewat iptables-legacy, karena kernel
# belum punya NFT_NAT sehingga fw4 gagal start. Sejak kernel memakai NFT_NAT
# (fw4 check rc=0), masquerade ditangani fw4 (chain srcnat_wan/srcnat_hotspot).
# MASQUERADE di sini DIBUANG supaya tidak dobel NAT.
#
# Yang tersisa: chain ROLXSTAT. Driver bam-dmux tidak mengisi
# /sys/class/net/wwan0/statistics maupun /proc/net/dev (semuanya 0), jadi rx/tx
# dihitung lewat aturan RETURN di chain itu dan dibaca rolex-3ginfo-json.

START=99
STOP=10

log() { logger -t rolex-nat "$*"; }

ipt() {
	for c in /usr/sbin/iptables /usr/sbin/iptables-legacy; do
		[ -x "$c" ] && { echo "$c"; return 0; }
	done
	return 1
}

start() {
	# hanya filter table yang dipakai (chain ROLXSTAT di FORWARD/INPUT/OUTPUT)
	K=/lib/modules/$(uname -r)
	lsmod | grep -q "^iptable_filter " || {
		f=$(find "$K" -name "iptable_filter.ko" 2>/dev/null | head -1)
		[ -n "$f" ] && insmod "$f" 2>/dev/null
	}

	I=$(ipt) || { log "iptables tak tersedia — ROLXSTAT dilewati"; return 1; }
	echo 1 > /proc/sys/net/ipv4/ip_forward
	$I -N ROLXSTAT 2>/dev/null
	$I -F ROLXSTAT 2>/dev/null
	$I -A ROLXSTAT -i wwan0 -j RETURN   # baris ini menghitung RX (in = wwan0)
	$I -A ROLXSTAT -o wwan0 -j RETURN   # baris ini menghitung TX (out = wwan0)
	for h in FORWARD INPUT OUTPUT; do
		$I -C $h -j ROLXSTAT 2>/dev/null || $I -I $h 1 -j ROLXSTAT
	done
	log "penghitung trafik wwan0 aktif (chain ROLXSTAT); NAT ditangani fw4"
}

stop() {
	I=$(ipt) || return 0
	$I -F ROLXSTAT 2>/dev/null
	log "penghitung trafik wwan0 dimatikan"
}

# true kalau chain ROLXSTAT sudah terpasang (dipakai rolex-watchdog)
status_quiet() {
	I=$(ipt) || return 1
	$I -n -L ROLXSTAT >/dev/null 2>&1
}