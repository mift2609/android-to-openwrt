#!/bin/sh /etc/rc.common
# rolex-nat — penghitung trafik wwan0 untuk halaman Modem LTE.
#
# Dulu skrip ini memasang MASQUERADE lewat iptables-legacy (kernel belum punya
# NFT_NAT). Sejak kernel memakai NFT_NAT, NAT ditangani fw4; MASQUERADE di sini
# dibuang supaya tidak dobel. Sisa satu tugas: menghitung rx/tx wwan0, sebab
# driver bam-dmux tidak mengisi /sys/class/net/wwan0/statistics.
#
# Sebelumnya penghitung dibuat dengan chain iptables ROLXSTAT. Itu membuat LuCI
# menampilkan peringatan "Legacy rules detected" di halaman Status > Firewall
# (setiap `-A` di iptables-save memicunya). Sekarang dipakai tabel nftables
# family netdev (hook ingress/egress pada device wwan0), jadi tidak ada aturan
# iptables sama sekali. Hook netdev terpisah dari fw4 (inet), jadi tidak
# mengubah filtering.

START=99
STOP=10

TBL=rolex_stat

log() { logger -t rolex-nat "$*"; }

start() {
	command -v nft >/dev/null 2>&1 || { log "nft tak tersedia — penghitung dilewati"; return 1; }

	# bersihkan sisa zaman iptables supaya LuCI tidak lagi memunculkan
	# "Legacy rules detected" (cek lama: iptables-save berisi baris -A)
	for I in /usr/sbin/iptables-legacy /usr/sbin/iptables; do
		[ -x "$I" ] || continue
		$I -F ROLXSTAT 2>/dev/null
		for h in INPUT FORWARD OUTPUT; do
			$I -D $h -j ROLXSTAT 2>/dev/null
		done
		$I -X ROLXSTAT 2>/dev/null
	done

	nft delete table netdev $TBL 2>/dev/null
	nft -f - <<-EOF || { log "gagal memasang tabel nft $TBL"; return 1; }
		table netdev $TBL {
			chain rx {
				type filter hook ingress device "wwan0" priority filter; policy accept;
				counter comment "rx"
			}
			chain tx {
				type filter hook egress device "wwan0" priority filter; policy accept;
				counter comment "tx"
			}
		}
	EOF
	log "penghitung trafik wwan0 aktif (nft netdev $TBL); NAT ditangani fw4"
}

stop() {
	nft delete table netdev $TBL 2>/dev/null
	log "penghitung trafik wwan0 dimatikan"
}

# dipakai rolex-watchdog
status_quiet() {
	nft list table netdev $TBL >/dev/null 2>&1
}