#!/bin/sh /etc/rc.common
# Mulai SEBELUM network (20) seperti mido-wifi: AP dibuat lebih dulu, sehingga netifd melihat phy
# sudah naik dan menandai radio0 "up" (bukan "down").
START=17
# rolex WiFi AP — hostapd manual dari konfigurasi yang bisa diedit LuCI.
# Kenapa hostapd manual, bukan netifd/wpad: di driver wcn36xx rolex, netifd/wpad gagal membuat
# vif AP ("hostapd.add_iface failed for phy phy0 ... No such device (-19)"). Layanan `wpad`
# karena itu DIMATIKAN (tanpa hostapd global, netifd tidak bisa memegang driver mode wlan0),
# dan AP dijalankan skrip ini. netifd tetap dipakai untuk L3: interface 'wifi' (device wlan0,
# static 192.168.43.1) memberi IP, dnsmasq melayani DHCP.
#
# Urutan memuat modul (TERBUKTI di rolex, 13 Nov 2026).
# PELAJARAN 1: `insmod` TIDAK menarik dependensi; daftar harus lengkap & berurutan.
# PELAJARAN 2: `wcnss_ctrl` WAJIB sebelum `qcom_wcnss_pil`.
# PELAJARAN 3: jangan pakai /sbin/modprobe (gagal rc=255 tanpa pesan di image ini).
# PELAJARAN 4: `iw phy phy0 interface add wlan0 type __ap` kadang ENOENT kalau bekas vif baru
#   dihapus -> perlu jeda + coba ulang.
MODS="libarc4 cfg80211 mac80211 mdt_loader qcom_common qcom_pil_info wcnss_ctrl qcom_wcnss_pil wcn36xx"
IFACE_DEV=wlan0
MAC=12:00:00:00:00:0a

log() { logger -t rolex-wifi "$*"; echo "$*" >> /tmp/wifi.log; }

# Perintah tambahan: `/etc/init.d/rolex-wifi sinkron` (dipakai rolex-watchdog tiap menit)
EXTRA_COMMANDS="sinkron"
EXTRA_HELP="	sinkron	Sinkronkan setelan UCI (/etc/config/wireless) ke AP yang berjalan"

# Kalau netifd sudah mengelola radio (sejak iwinfo terpasang, cara ini bekerja), jangan
# jalankan hostapd manual — kalau tidak, dua hostapd berebut wlan0.
netifd_pegang() {
	ubus call network.wireless status 2>/dev/null | grep -q '"up": true' &&
		iw dev "$IFACE_DEV" info 2>/dev/null | grep -q "type AP"
}

bikin_vif_ap() {
	i=0
	while [ $i -lt 4 ]; do
		if iw dev "$IFACE_DEV" info 2>/dev/null | grep -q "type AP"; then return 0; fi
		ip link set "$IFACE_DEV" down 2>/dev/null
		iw dev "$IFACE_DEV" del 2>/dev/null
		sleep 2
		iw phy phy0 interface add "$IFACE_DEV" type __ap 2>&1 | while read l; do log "iw add: $l"; done
		sleep 1
		[ -e /sys/class/net/$IFACE_DEV ] && { log "vif AP dibuat (percobaan $((i+1)))"; return 0; }
		i=$((i+1)); sleep 2
	done
	log "gagal membuat vif AP setelah $i percobaan"
	return 1
}

# Ambil alih wlan0: matikan hostapd milik netifd (kalau ada) dan buang vif AP sisa.
# Tanpa ini hostapd lama bertahan dengan konfigurasi lama -> setelan UCI baru tak terpakai
# (pelajaran dari mido-wifi; driver wcn36xx hanya melayani satu vif AP).
ambil_alih() {
	for p in $(ps | grep -v grep | grep hostapd | awk '{print $1}'); do
		[ "$p" = "$$" ] && continue
		kill $p 2>/dev/null
	done
	sleep 1
	for j in $(ls /sys/class/net 2>/dev/null | grep -E '^phy[0-9]+-ap[0-9]+$'); do
		iw dev "$j" del 2>/dev/null && log "vif sisa $j dihapus"
	done
}

# Selaraskan AP dengan setelan UCI. Dipanggil rolex-watchdog tiap menit, jadi mengubah
# SSID/sandi/channel lewat LuCI (Network -> Wireless) atau uci langsung ikut terpakai.
sinkron() {
	[ -e /sys/class/net/$IFACE_DEV ] || return 0
	WANT=$(/usr/bin/rolex-wifi-ctl fingerprint 2>/dev/null)
	HAVE=$(cat /etc/hostapd-rolex.state 2>/dev/null)
	if [ -n "$WANT" ] && [ "$WANT" != "$HAVE" ]; then
		log "sinkron: setelan UCI berubah - AP dijalankan ulang (ssid=$(uci -q get wireless.wifinet0.ssid) ch=$(uci -q get wireless.radio0.channel))"
		/usr/bin/rolex-wifi-ctl apply >/dev/null 2>&1
	fi
}

start() {
	echo "=== rolex-wifi $(date) ===" >> /tmp/wifi.log
	KREL=$(uname -r); MDIR=/lib/modules/$KREL
	for m in $MODS; do
		lsmod | grep -q "^$m " && continue
		ko=$(find "$MDIR" -name "$m.ko" | head -1)
		[ -n "$ko" ] || { log "modul $m tidak ada di $MDIR"; continue; }
		/sbin/insmod "$ko" 2>&1 | while read l; do log "insmod $m: $l"; done
	done

	i=0
	while [ $i -lt 90 ]; do
		[ -e /sys/class/ieee80211/phy0 ] && break
		i=$((i+1)); sleep 1
	done
	[ -e /sys/class/ieee80211/phy0 ] || { log "phy0 TIDAK muncul (${i}s)"; return 0; }
	log "phy0 muncul setelah ${i}s"

	# Lepaskan radio dari netifd dulu: kalau netifd sempat `wifi up` (mis. radio di-Enable di LuCI),
	# hostapd-nya memegang driver mode wlan0 dan hostapd kita gagal
	# ("nl80211: kernel reports: Match already configured" / "Could not configure driver mode").
	wifi down >/dev/null 2>&1
	sleep 2
	# dan kunci radionya di UCI supaya netifd tak mencoba lagi (kalau dicoba, vif kita dihapus)
	[ "$(uci -q get wireless.radio0.disabled)" = "1" ] || { uci set wireless.radio0.disabled=1; uci commit wireless; }
	ambil_alih
	bikin_vif_ap || return 0
	ip link set "$IFACE_DEV" address $MAC 2>/dev/null
	ip link set "$IFACE_DEV" up

	# konfigurasi AP dari uci lalu jalankan hostapd
	/usr/bin/rolex-wifi-ctl apply >/dev/null 2>&1
	sleep 4
	log "iw: $(iw dev 2>/dev/null | grep -E 'ssid|type|channel' | tr '\n' ' ')"

	# IP + DHCP (netifd interface 'wifi' biasanya sudah memasangnya; ini cadangan)
	ip -4 addr show "$IFACE_DEV" 2>/dev/null | grep -q "inet " || ip addr add 192.168.43.1/24 dev "$IFACE_DEV" 2>/dev/null
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
	log "addr: $(ip -4 addr show "$IFACE_DEV" 2>/dev/null | grep inet | tr -s ' ')"
}

stop() {
	killall hostapd 2>/dev/null
}
