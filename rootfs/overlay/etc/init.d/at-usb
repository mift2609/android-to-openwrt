#!/bin/sh /etc/rc.common
# at-usb — salurkan port AT modem ke PC lewat kabel USB (CDC-ACM).
#
# Rantai: PC (/dev/ttyACM0) <-> gadget /dev/ttyGS0 <-> socat <-> tty AT modem
#
# PENTING: modem punya DUA channel AT (DATA4 + DATA1) -> dua tty (/dev/ttyRPMSG0, /dev/ttyRPMSG1).
# Skrip rolex sendiri (rolex-lte-run, rolex-modem-ctl) memakai SATU tty (yang utama, lihat
# /usr/bin/rolex-at-port). Penyaluran ke PC memakai tty AT yang LAIN supaya jawaban AT tidak
# "dicuri" socat — kalau satu channel dipakai dua pihak, verifikasi jawaban (mis. AT+CFUN?)
# gagal dan modem bisa ditinggal dalam keadaan RF mati.
#
# Kalau hanya ada satu tty AT, layanan ini berhenti diam-diam (biar LTE tidak terganggu).
# Di PC:  sms_tool -d /dev/ttyACM0 at "AT+CGMM"   |   gcom -d /dev/ttyACM0 -s skrip.gcom

START=96
STOP=10

GS=/dev/ttyGS0
LOG_TAG=at-usb

log() { logger -t "$LOG_TAG" "$*"; }

# cari tty AT modem: utamakan yang BUKAN dipakai skrip rolex
at_tty_usb() {
	utama=$(/usr/bin/rolex-at-port 2>/dev/null)
	for p in /dev/ttyRPMSG1 /dev/ttyRPMSG0; do
		[ -c "$p" ] || continue
		[ "$p" = "$utama" ] && continue
		echo "$p"; return 0
	done
	return 1
}

start_service() {
	command -v socat >/dev/null 2>&1 || { log "socat tidak ada — dilewati"; return 1; }

	i=0
	while [ $i -lt 20 ]; do
		[ -c "$GS" ] && break
		sleep 2; i=$((i + 1))
	done
	[ -c "$GS" ] || { log "$GS belum ada (kernel tanpa USB_CONFIGFS_ACM?) — dilewati"; return 1; }

	ATU=$(at_tty_usb) || { log "hanya satu tty AT — tak disalurkan (biar LTE aman)"; return 1; }

	log "menyalurkan $ATU -> $GS (PC melihat /dev/ttyACM0)"
	procd_open_instance
	procd_set_param command socat -d -d -s \
		-t 30 "$GS",raw,echo=0,nonblock,ignoreeof \
		"$ATU",raw,echo=0,nonblock,ignoreeof
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() { log "penyaluran AT lewat USB dihentikan"; }

service_triggers() {
	procd_add_reload_trigger "at-usb"
}
