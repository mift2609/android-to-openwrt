#!/bin/sh
# Tuning rolex untuk hotspot harian: CPU tidak diturunkan frekuensinya (hindari
# "stutter" saat banyak klien), qdisc fq + buffer TCP lebih besar untuk LTE.
# Dijalankan sekali setelah init selesai.

for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
	[ -e "$g" ] && echo performance > "$g" 2>/dev/null
done

# kernel rolex tidak punya net.core.default_qdisc (CONFIG_NET_SCH minim), jadi
# fq/cake tidak bisa dipasang. Cukup buffer + fastopen di bawah.
sysctl -q -w net.ipv4.tcp_congestion_control=cubic
sysctl -q -w net.core.rmem_max=4194304
sysctl -q -w net.core.wmem_max=1048576
sysctl -q -w net.ipv4.tcp_rmem='4096 87380 4194304'
sysctl -q -w net.ipv4.tcp_wmem='4096 65536 1048576'
sysctl -q -w net.ipv4.tcp_fastopen=3
sysctl -q -w net.ipv4.tcp_slow_start_after_idle=0

exit 0