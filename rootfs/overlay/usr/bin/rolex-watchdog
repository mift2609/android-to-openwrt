#!/bin/sh
# rolex-watchdog — jaga layanan penting tetap hidup (dijalankan cron tiap 2 menit).
#
# Kenapa perlu: urutan boot di device ini tidak selalu mulus —
#   * MSS modem kadang masih "offline" saat rolex-modem jalan di S95 (LTE tak pernah naik),
#   * layanan procd rolex-lte bisa berhenti,
#   * vif AP WiFi kadang hilang saat netifd menata ulang interface.
# Daripada mengandalkan urutan rc.d, watchdog ini memulihkan tiap 2 menit.
LOG=/var/log/rolex-watchdog.log
MSS=/sys/class/remoteproc/remoteproc1/state
say() { echo "$(date '+%F %T') $*" >> $LOG; }

[ "$(cat $MSS 2>/dev/null)" = "running" ] || {
	say "MSS modem offline -> bring-up (modules + modem)"
	/etc/init.d/rolex-modules start >/dev/null 2>&1
	/etc/init.d/rolex-modem start >/dev/null 2>&1
}

/etc/init.d/rolex-lte running || {
	say "layanan rolex-lte mati -> start"
	/etc/init.d/rolex-lte start >/dev/null 2>&1
}

iw dev wlan0 info 2>/dev/null | grep -q "type AP" || {
	say "AP WiFi mati -> start rolex-wifi"
	/etc/init.d/rolex-wifi start >/dev/null 2>&1
}

# NAT klien: kernel ini tanpa NFT_NAT -> fw4 gagal, jadi aturan iptables-legacy dijaga di sini
if [ -x /etc/init.d/rolex-nat ]; then
	if [ -x /usr/sbin/iptables ]; then I=/usr/sbin/iptables; else I=/usr/sbin/iptables-legacy; fi
	$I -t nat -C POSTROUTING -o wwan0 -j MASQUERADE 2>/dev/null || {
		say "aturan NAT klien hilang -> dipasang ulang"
		/etc/init.d/rolex-nat start >/dev/null 2>&1
	}
fi

# AdGuard Home (DNS penyaring iklan) — kalau mati, hidupkan lagi
if [ -x /etc/init.d/adguardhome ]; then
	/etc/init.d/adguardhome running >/dev/null 2>&1 || {
		say "AdGuard Home mati -> dinyalakan"
		/etc/init.d/adguardhome start >/dev/null 2>&1
	}
fi

# vnStat: interface terdaftar + layanan jalan (untuk lihat pemakaian data)
[ -x /usr/bin/rolex-vnstat-init ] && /usr/bin/rolex-vnstat-init

# ModemManager: pastikan modem terlihat DAN aktif.
# Modem harus "enabled" supaya SMS bisa dibaca/dikirim lewat QMI (mmcli).
# Diuji: mengaktifkan MM TIDAK mengganggu sesi data kita (LTE tetap io=ok).
if [ "$(cat $MSS 2>/dev/null)" = "running" ]; then
	mmcli -L 2>/dev/null | grep -q "ModemManager1/Modem" || {
		say "ModemManager tidak melihat modem -> restart MM"
		/etc/init.d/modemmanager restart >/dev/null 2>&1
	}
	mmstate=$(mmcli -m any 2>/dev/null | sed -n 's/^.*|[[:space:]]*state:[[:space:]]*\(.*\)$/\1/p' | head -1)
	if [ "$mmstate" = "disabled" ]; then
		say "ModemManager: modem disabled -> diaktifkan (SMS lewat QMI)"
		mmcli -m any --enable >/dev/null 2>&1
	fi
fi

# perubahan konfigurasi dari LuCI (Network -> Wireless) diterapkan ke AP
[ -x /usr/bin/rolex-wifi-ctl ] && /usr/bin/rolex-wifi-ctl sync >/dev/null 2>&1

# jaga ukuran log
[ -f $LOG ] && [ "$(wc -l < $LOG)" -gt 500 ] && { tail -200 $LOG > $LOG.tmp && mv $LOG.tmp $LOG; }
exit 0
