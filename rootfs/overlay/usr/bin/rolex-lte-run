#!/bin/sh
# rolex-lte-run — jaga data call LTE rolex (msm8917, mainline) hidup.
#
# Pelajaran dari perangkat (semua terbukti):
#  * Firmware modem TIDAK mengaktifkan UIM provisioning session sendiri: kartu "present"
#    tapi application tetap 'detected' dan AT+CPIN? = SIM busy -> aktifkan lewat QMI UIM
#    Change Provisioning Session (qmicli >= 1.34).
#  * bam-dmux: WDS Start Network WAJIB didahului Bind Mux Data Port di klien QMI yang sama
#    (tanpa itu: QMI error 70 InvalidOperation). qmicli hanya boleh 1 aksi WDS per proses
#    -> dipakai /usr/bin/rolex-qmi mode `up` (menahan klien selama call hidup).
#  * Setelah modem di-restart, port AT sering belum siap: AT+CFUN=1 bisa hilang diam-diam
#    (CFUN tetap 0 -> modem hanya 'not-registered-searching'). Karena itu CFUN diverifikasi
#    ulang lewat AT+CFUN? sampai bernilai 1.
Q=/usr/bin/qmicli
T=/usr/bin/rolex-qmi
# port AT: kernel baru = tty /dev/ttyRPMSG*; kernel lama = /dev/wwan0at0.
# Jangan dipatok — pakai deteksi (lihat /usr/bin/rolex-at-port).
at_port() { /usr/bin/rolex-at-port 2>/dev/null || echo /dev/wwan0at0; }
MSS=/sys/class/remoteproc/remoteproc1/state
LOG=/var/log/rolex-lte.log
APN=${APN:-internet}
# APN/IP family/profile bisa diatur dari LuCI (menu Modem → Modem LTE) lewat
# uci /etc/config/rolexlte. Nilai env tetap menang supaya debug manual tetap bisa.
_uci() { uci -q get "rolexlte.main.$1" 2>/dev/null; }
[ -z "${APN_SET:-}" ] && { _a=$(_uci apn); [ -n "$_a" ] && APN=$_a; }
IPFAM=$(_uci ipfam); [ -n "$IPFAM" ] || IPFAM=ipv4
PROFILE=$(_uci profile)
# penjaga internet (auto ganti IP):
#   check_secs     = tiap berapa detik internet dicek
#   check_fails    = berapa kali gagal berturut-turut sebelum sesi data diulang (IP baru)
#   rotate_mins    = paksa ganti IP tiap N menit (0 = mati)
#   restart_after  = berapa kali pengulangan sesi gagal berturut-turut sebelum modem MSS di-restart
CHECK=$(_uci check_secs); [ -n "$CHECK" ] || CHECK=60
FAILS=$(_uci check_fails); [ -n "$FAILS" ] || FAILS=3
ROTATE=$(_uci rotate_mins); [ -n "$ROTATE" ] || ROTATE=0
RESTART_AFTER=$(_uci restart_after); [ -n "$RESTART_AFTER" ] || RESTART_AFTER=3
GRACE=$(_uci grace_secs); [ -n "$GRACE" ] || GRACE=60
# Usaha terakhir: kalau beberapa restart MSS berturut-turut tetap tanpa data (gejala nyata:
# terdaftar + IP ada tetapi paket tidak lewat), reboot perangkat adalah satu-satunya pemulihan
# yang terbukti. 0 = jangan pernah.
REBOOT_AFTER_MSS=$(_uci reboot_after_mss); [ -n "$REBOOT_AFTER_MSS" ] || REBOOT_AFTER_MSS=2
# target ping bisa diganti lewat env (untuk menguji sendiri, mis. PING_TARGET=10.255.255.1)
_pt=$(_uci ping_target); [ -n "$_pt" ] && PING_TARGET=$_pt
PING_TARGET=${PING_TARGET:-8.8.8.8}
export IPFAM PROFILE

log() { echo "$(date '+%H:%M:%S') $*" >> $LOG; }

at_open() { exec 3<>$AT 2>/dev/null; stty -F $AT raw -echo 115200 2>/dev/null; }
at_send() { [ -e "$AT" ] || return 1; printf '%s\r' "$1" > "$AT" 2>/dev/null; }
# at_expect <cmd> <substring> <timeout detik>
at_expect() {
	c=$1; want=$2; tmo=${3:-15}
	[ -e "$AT" ] || return 1
	exec 3<>$AT 2>/dev/null
	stty -F $AT raw -echo 115200 2>/dev/null
	printf '%s\r' "$c" >&3
	t=0
	while [ $t -lt $tmo ]; do
		while read -t 2 -r line <&3; do
			echo "$line" | grep -q -- "$want" && { exec 3<&-; return 0; }
		done
		t=$((t+2))
	done
	exec 3<&-
	return 1
}

qmi_wait() {
	i=0
	while [ $i -lt 90 ]; do
		$Q -d qrtr://0 --dms-get-manufacturer >/dev/null 2>&1 && return 0
		sleep 1; i=$((i+1))
	done
	return 1
}

uim_session() {
	$Q -d qrtr://0 --uim-get-card-status 2>/dev/null | grep -q "session doesn't exist" || return 0
	AID=$($Q -d qrtr://0 --uim-get-card-status 2>/dev/null | grep "usim (2)" -m1 -A3 | tail -1 | awk '{print $1}' | tr -d ' ')
	[ -z "$AID" ] && AID="A0:00:00:00:87:10:02:FF:FF:FF:FF:89:07:09:00:00"
	$Q -d qrtr://0 --uim-change-provisioning-session="slot=1,activate=yes,session-type=primary-gw-provisioning,aid=$AID" >/dev/null 2>&1
	log "sesi UIM aktif (slot 1)"
}

# CFUN=1 dengan verifikasi; ulangi kalau port AT belum siap
ssp_auto() {
	# Di firmware ini AT+COPS=0 menjawab ERROR; pemicu registrasi yang andal adalah
	# NAS Set System Selection Preference = automatic.
	$Q -d qrtr://0 --nas-set-system-selection-preference="automatic" >/dev/null 2>&1
	log "system selection: automatic"
}

rf_on() {
	# Utamakan QMI (--dms-set-operating-mode=online). Sejak kernel baru, channel AT
	# menjadi tty /dev/ttyRPMSG* dan TIDAK selalu menjawab "AT" (terbukti: modem
	# 'shutting-down' -> registrasi 'not-registered-searching'), sedangkan QMI selalu ada.
	if $Q -d qrtr://0 --dms-set-operating-mode=online >/dev/null 2>&1; then
		i=0
		while [ $i -lt 10 ]; do
			case "$($Q -d qrtr://0 --dms-get-operating-mode 2>/dev/null | tr -d "'")" in
				*"Mode: online"*) log "RF on (QMI: operating mode online)"; return 0 ;;
			esac
			sleep 2; i=$((i+1))
		done
		log "QMI: mode belum 'online' — coba jalur AT"
	fi
	# Cadangan jalur lama: AT+CFUN=1 lewat port AT (kalau alat/tty-nya menjawab)
	i=0
	while [ $i -lt 6 ]; do
		at_expect "AT+CFUN=1" "OK" 8 && at_expect "AT+CFUN?" "+CFUN: 1" 8 && { log "RF on (AT+CFUN=1)"; return 0; }
		sleep 3; i=$((i+1))
	done
	log "peringatan: RF tidak bisa dipastikan menyala"
	return 1
}

reg_state() { $Q -d qrtr://0 --nas-get-serving-system 2>/dev/null | grep -m1 "Registration state"; }
wait_register() {
	i=0
	while [ $i -lt 120 ]; do
		case "$(reg_state)" in *"'registered'"*) return 0;; esac
		sleep 4; i=$((i+4))
	done
	return 1
}

modem_via_init() {
	# Bring-up penuh lewat skrip init: modul + salin firmware dari partisi modem + rmtfs + MSS.
	# Perlu karena toggle remoteproc saja TIDAK cukup kalau MSS belum pernah dinyalakan
	# (gejala: "4080000.remoteproc offline" setelah boot -> LTE tak pernah naik).
	log "MSS belum jalan -> rolex-modules + rolex-modem"
	/etc/init.d/rolex-modules start >/dev/null 2>&1
	/etc/init.d/rolex-modem start >/dev/null 2>&1
	sleep 5
}

modem_restart() {
	if [ ! -e "$MSS" ] || [ "$(cat $MSS 2>/dev/null)" != "running" ]; then
		modem_via_init
	else
		log "restart remoteproc MSS"
		echo stop > $MSS 2>/dev/null; sleep 3
		echo start > $MSS 2>/dev/null
	fi
	qmi_wait
	uim_session
	sleep 3
	rf_on
}

apply_ip() {
	IP=$(awk '/^IPv4 /{print $2}' /tmp/rolex-lte.dyn | tail -1)
	GW=$(awk '/^GW /{print $2}' /tmp/rolex-lte.dyn | tail -1)
	MASK=$(awk '/^MASK /{print $2}' /tmp/rolex-lte.dyn | tail -1)
	D1=$(awk '/^DNS1 /{print $2}' /tmp/rolex-lte.dyn | tail -1)
	D2=$(awk '/^DNS2 /{print $2}' /tmp/rolex-lte.dyn | tail -1)
	[ -z "$IP" ] && return 1
	case $MASK in
		255.255.255.192) PFX=26;; 255.255.255.224) PFX=27;; 255.255.255.240) PFX=28;;
		255.255.255.248) PFX=29;; 255.255.255.252) PFX=30;; 255.255.255.0) PFX=24;;
		*) PFX=30;;
	esac
	# Operator kadang memberi alamat yang justru NETWORK ADDRESS untuk prefix itu
	# (mis. 10.147.178.64/30 -> semua host bit nol). Paket lalu tak bisa dikirim karena
	# sumber paket tak sah. Naikkan prefix sampai alamat itu jadi host address yang sah.
	LAST=${IP##*.}
	BLK=$(( 1 << (32 - PFX) ))
	if [ $(( LAST % BLK )) -eq 0 ] && [ $PFX -lt 31 ]; then
		PFX=$(( PFX + 1 ))
		log "IP $IP adalah network address untuk /$((PFX-1)) -> pakai /$PFX"
	fi
	ip link set wwan0 up
	# sesi baru -> penanda waktu uplink dihapus dulu (dipasang lagi setelah IP terpasang)
	rm -f /tmp/rolex-wwan0-since
	ip addr flush dev wwan0 2>/dev/null
	ip addr add "$IP/$PFX" dev wwan0
	# onlink: gateway operator kadang di luar mask yang dilaporkan modem (mis. IP .63/30,
	# gw .64) -> tanpa onlink, "ip route add default" ditolak "Network unreachable".
	ip route replace default via "$GW" dev wwan0 onlink
	{ [ -n "$D1" ] && echo "nameserver $D1"; [ -n "$D2" ] && echo "nameserver $D2"; } > /etc/resolv.conf
	log "wwan0 $IP/$PFX gw $GW dns $D1,$D2"
	# catat kapan uplink naik (dipakai penghitung "conn_time" di halaman 4G Connection)
	cut -d. -f1 /proc/uptime > /tmp/rolex-wwan0-since 2>/dev/null
}

log "=== mulai $(date) ==="
qmi_wait || { log "QMI tidak siap"; modem_restart; }
uim_session
rf_on
ssp_auto

if ! wait_register; then
	log "belum terdaftar -> restart modem"
	modem_restart
	ssp_auto
	wait_register || log "tetap belum terdaftar, tetap coba data"
fi

bad=0; mss_count=0
while :; do
	$Q -d qrtr://0 --dpm-open-port="hw-data-ep-type=bam-dmux,hw-data-ep-iface-number=0,hw-data-rx-id=1,hw-data-tx-id=1" >/dev/null 2>&1
	sleep 2
	: > /tmp/rolex-lte.dyn
	$T up "$APN" > /tmp/rolex-lte.dyn 2>&1 &
	RP=$!
	i=0
	while [ $i -lt 90 ]; do
		grep -q "^IPv4 " /tmp/rolex-lte.dyn 2>/dev/null && { apply_ip; break; }
		kill -0 $RP 2>/dev/null || break
		sleep 1; i=$((i+1))
	done
	# Penjaga internet: ping lewat wwan0. Kalau hang, sesi data diulang -> operator
	# memberi IP baru. Kalau sering berulang, modem MSS di-restart (usaha terakhir).
	bf=0
	rot_since=$(cut -d. -f1 /proc/uptime)
	# tenggang: sesi baru diberi waktu $GRACE detik sebelum dinilai (biar tidak dianggap bengong
	# padahal baru selesai mendaftar)
	sleep ${GRACE:-60}
	while kill -0 $RP 2>/dev/null; do
		sleep $CHECK
		if ! timeout 6 ping -c1 -W3 -I wwan0 "$PING_TARGET" >/dev/null 2>&1; then
			bf=$((bf + 1))
			log "cek internet gagal ($bf/$FAILS)"
			if [ "$bf" -ge "$FAILS" ]; then
				log "internet mati -> sesi data diulang (minta IP baru)"
				bad=$((bad + 1)); break
			fi
			continue
		fi
		# ada jawaban: sesi sehat
		bf=0; bad=0; mss_count=0
		if [ "$ROTATE" -gt 0 ] 2>/dev/null; then
			now=$(cut -d. -f1 /proc/uptime)
			if [ $((now - rot_since)) -ge $((ROTATE * 60)) ]; then
				log "rotasi IP berkala ($ROTATE menit) -> sesi data diulang"
				break
			fi
		fi
		ip -4 addr show wwan0 2>/dev/null | grep -q "inet " || { log "IP hilang"; bad=$((bad + 1)); break; }
	done
	kill $RP 2>/dev/null; wait $RP 2>/dev/null
	log "call berhenti, ulang 5s"
	sleep 5
	if [ "${bad:-0}" -ge "$RESTART_AFTER" ]; then
		log "sesi diulang $bad kali berturut-turut tanpa internet -> restart modem MSS"
		modem_restart; ssp_auto; bad=0; bf=0
		mss_count=$(( ${mss_count:-0} + 1 ))
		if [ "$REBOOT_AFTER_MSS" -gt 0 ] 2>/dev/null && [ "$mss_count" -ge "$REBOOT_AFTER_MSS" ]; then
			log "setelah $mss_count restart MSS tetap tanpa data -> reboot perangkat"
			sync; sleep 3; reboot
		fi
		# beri modem waktu bangun & mendaftar dulu; tanpa jeda ini restart bisa beruntun
		log "menunggu ${GRACE:-60}s setelah restart modem (biar modem sempat mendaftar)"; sleep ${GRACE:-60}
	fi
	wait_register || { log "belum terdaftar -> restart modem"; modem_restart; ssp_auto; }
done